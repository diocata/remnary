#!/bin/sh
# Use the isolated development toolchain when present; otherwise use installed Cargo.
set -eu
remnary_root=$(cd "$(dirname "$0")/.." && pwd)
if [ -x "$remnary_root/.tools/cargo/bin/cargo" ]; then
    export CARGO_HOME="$remnary_root/.tools/cargo"
    export RUSTUP_HOME="$remnary_root/.tools/rustup"
    exec "$CARGO_HOME/bin/cargo" "$@"
fi
exec cargo "$@"
