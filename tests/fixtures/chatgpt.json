          "create_time": 1792324800,
          "content": {
            "content_type": "text",
            "parts": ["I want to build Observr in Rust. Could we store my AI conversations as Markdown files?"]
          },
          "metadata": {}
        }
      },
      "11111111-1111-4111-8111-111111111113": {
        "id": "11111111-1111-4111-8111-111111111113",
        "parent": "11111111-1111-4111-8111-111111111112",
        "children": ["11111111-1111-4111-8111-111111111114"],
        "message": {
          "id": "11111111-1111-4111-8111-111111111113",
          "author": {"role": "assistant"},
          "create_time": 1792324820,
          "content": {
            "content_type": "text",
            "parts": ["Rust can use SQLite for one local database file, with Markdown exports for reading and editing. We could also introduce separate services for search and background analysis."]
          },
          "metadata": {}
        }
      },
      "11111111-1111-4111-8111-111111111114": {
        "id": "11111111-1111-4111-8111-111111111114",
        "parent": "11111111-1111-4111-8111-111111111113",
        "children": ["11111111-1111-4111-8111-111111111115"],
        "message": {
          "id": "11111111-1111-4111-8111-111111111114",
          "author": {"role": "user"},
          "create_time": 1792324840,
          "content": {
            "content_type": "text",
            "parts": ["Keep the implementation simple. Start with Rust and SQLite, plus readable Markdown exports. I do not want extra services for the first version."]
          },
          "metadata": {}
        }
      },
      "11111111-1111-4111-8111-111111111115": {
        "id": "11111111-1111-4111-8111-111111111115",
        "parent": "11111111-1111-4111-8111-111111111114",
        "children": [],
        "message": {
          "id": "11111111-1111-4111-8111-111111111115",
          "author": {"role": "assistant"},
          "create_time": 1792324860,
          "content": {
            "content_type": "text",
            "parts": ["We will start with a Rust CLI, a local SQLite database, and Markdown exports. The first workflow imports conversations and searches the original messages."]
          },
          "metadata": {}
        }
      }
    }
